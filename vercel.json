{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "yarn --cwd frontend install --frozen-lockfile && yarn --cwd frontend build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "backend/server.py": {
      "includeFiles": "backend/data/**/*.csv"
    }
  }
}